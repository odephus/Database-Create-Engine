cmake_minimum_required(VERSION 3.16)
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(dir "${CMAKE_CURRENT_BINARY_DIR}/dbce-cli-${nonce}")
if(EXISTS "${dir}")
    message(FATAL_ERROR "Temporary fixture directory already exists")
endif()
file(MAKE_DIRECTORY "${dir}")

function(run expected pattern)
    execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${dir}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
    if(NOT "${rc}" STREQUAL "${expected}" OR NOT "${out}${err}" MATCHES "${pattern}")
        message(FATAL_ERROR "${ARGN} returned ${rc}\n${out}${err}")
    endif()
    if(expected AND out MATCHES "\\[OK\\]")
        message(FATAL_ERROR "Failed command printed success: ${out}")
    endif()
endfunction()

run(0 "\\[OK\\]" create db fixture)
run(0 "\\[OK\\]" add fixture a hello)
run(0 "hello" get fixture a)
run(0 "hello" get fixture.dbce table)
run(0 "fixture.dbce" db list)
run(0 "\\[OK\\]" del fixture a)
run(1 ".+" get fixture a)
string(REPEAT "k" 64 long_key)
string(REPEAT "d" 256 long_db)
run(1 ".+" add fixture "${long_key}" bad)
run(1 ".+" create db "${long_db}")
file(WRITE "${dir}/input" "add ${long_key} value\nget table\nexit\n")
execute_process(COMMAND "${CLI}" go fixture WORKING_DIRECTORY "${dir}"
    INPUT_FILE "${dir}/input" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
if(NOT "${rc}" STREQUAL "1" OR out MATCHES "\\[OK\\]" OR err STREQUAL "")
    message(FATAL_ERROR "REPL failure handling: ${rc} ${out}${err}")
endif()
file(WRITE "${dir}/broken.dbce" "short")
run(1 ".+" create db broken)
file(READ "${dir}/broken.dbce" bytes)
if(NOT bytes STREQUAL "short")
    message(FATAL_ERROR "Opening a corrupt CLI fixture changed its bytes")
endif()
file(REMOVE "${dir}/input" "${dir}/fixture.dbce" "${dir}/broken.dbce")
file(GLOB leftovers "${dir}/*")
if(leftovers)
    message(FATAL_ERROR "Unexpected output files: ${leftovers}")
endif()
file(REMOVE_RECURSE "${dir}")
